# ─────────────────────────────────────────────────────────────────────────────
# Pulso — configuração. Copie para ".env" (local) ou cadastre cada linha nas
# Variables do Railway (produção). O site sobe mesmo faltando chaves opcionais:
# o log do servidor avisa o que ficou desligado.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço público do site (links de volta do pagamento e avisos automáticos).
# Enquanto o domínio não estiver apontado, use o endereço que o Railway gera (…up.railway.app).
APP_URL=https://pulso.mgrservicosdigitais.com.br

# Painel /admin: e-mail(s) do dono (separe vários por vírgula) + um código secreto que você
# digita UMA vez em /admin para confirmar que é você. Invente uma frase longa (20+ caracteres).
ADMIN_EMAILS=seu-email@exemplo.com
ADMIN_TOKEN=

# ── Preços (por vídeo) ───────────────────────────────────────────────────────
# Site em português cobra em reais (Mercado Pago). Inglês e espanhol cobram em dólar (Stripe).
PRICE_BRL=29.90
PRICE_BRL_20=34.90
PRICE_USD=9.90
PRICE_USD_20=12.90

# ── Mercado Pago (reais: Pix e cartão) ───────────────────────────────────────
# mercadopago.com.br/developers/panel/app → sua aplicação → Credenciais de produção → Access Token
MP_ACCESS_TOKEN=
# Suas integrações → Webhooks → "Assinatura secreta" (URL: https://SEU-DOMINIO/api/webhooks/mercadopago)
MP_WEBHOOK_SECRET=
# 1 = recusa avisos sem assinatura (ligue depois de configurar o webhook acima)
MP_WEBHOOK_REQUIRE_SIGNATURE=0
# Nome que aparece na fatura do cartão (até 13 letras)
MP_STATEMENT_DESCRIPTOR=PULSOVIDEOS

# ── Stripe (dólar: cartão, Apple Pay, Google Pay) ───────────────────────────
# dashboard.stripe.com → Developers → API keys → Secret key (sk_live_… ; para testar, sk_test_…)
STRIPE_SECRET_KEY=
# Developers → Webhooks → Add endpoint: https://SEU-DOMINIO/api/webhooks/stripe
# eventos: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
# depois copie o "Signing secret" (whsec_…)
STRIPE_WEBHOOK_SECRET=

# ── IA do roteiro (Anthropic) ────────────────────────────────────────────────
# console.anthropic.com/settings/keys (pode ser a mesma chave do Fluxo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Limites de uso da IA (roteiros por dia): total do site, por conta, e por visitante sem conta
AI_DAILY_CAP=400
AI_PER_USER_DAY=25
AI_PER_IP_DAY=6

# ── Dados da empresa (rodapé, Termos e Privacidade) ──────────────────────────
COMPANY_NAME=MGR Serviços Digitais
COMPANY_DOC=
COMPANY_CITY=
SUPPORT_EMAIL=
# WhatsApp do suporte com DDI e DDD, só números (ex.: 5511900000000)
SUPPORT_WHATSAPP=

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
# Onde ficam banco, imagens, marcas salvas e vídeos. No Railway, monte um Volume em /data.
DATA_DIR=/data
# Dias que o vídeo pronto fica disponível para download
VIDEO_RETENTION_DAYS=30
# Correções grátis por vídeo comprado
FREE_EDITS=1

# ── Render (normalmente não precisa mexer) ───────────────────────────────────
# Quadros por segundo do vídeo final
RENDER_FPS=60
# Abas do Chrome desenhando em paralelo (padrão: nº de CPUs, até 4)
# RENDER_PAGES=4
# Qualidade/velocidade do H.264: ultrafast…veryslow (padrão faster) e CRF (menor = melhor)
# RENDER_PRESET=faster
# RENDER_CRF=20
# Caminhos, se não estiverem no padrão da imagem Docker
# CHROME_PATH=/usr/bin/chromium
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
